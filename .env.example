# China–Taiwan Monitor — environment variables.
#
# Copy this file to .env (which is gitignored) and fill in the values. The
# workers and the seed-sources script read from .env via dotenv. Vercel reads
# the dashboard's vars from project settings, not this file.

# ─────────────────────────────────────────────────────────────────────
# Supabase (Phase 2 — required)
# ─────────────────────────────────────────────────────────────────────

# Project URL: https://<project-ref>.supabase.co
SUPABASE_URL=

# Public anon key — safe to expose to the browser. Used by the dashboard
# server (RLS-gated reads) and as a fallback for SSR.
SUPABASE_ANON_KEY=

# Service-role key — full DB access. NEVER expose to a browser bundle. Used
# only by workers and the seed-sources script.
SUPABASE_SERVICE_ROLE_KEY=

# Convenience for Next.js: when running the dashboard locally, expose the
# same URL/anon under the NEXT_PUBLIC_ prefix so client components could
# also read them if needed. (Server components read the unprefixed forms.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────
# Anthropic (Phase 3 — required for translation, scoring, brief generation)
# ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Resend (Phase 3 — required to send newsletter)
# ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Stripe (Phase 5)
# ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────
# X / Twitter (Phase 4–5)
# ─────────────────────────────────────────────────────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BOT_ENABLED=false
